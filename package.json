{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "thirteen",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "description": "Laravel 13 application.",
    "author": "Marco Girometta",
    "license": "MIT",
    "packageManager": "pnpm@11.15.0",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --cache --fix",
        "lint:check": "eslint . --cache",
        "preinstall": "npx only-allow pnpm",
        "prepare": "node .husky/install.mjs || true",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "test:ui": "vitest run --project=storybook --coverage",
        "types": "tsc --noEmit"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@inertiajs/core": "^3.6.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@rolldown/plugin-babel": "^0.2.3",
        "@storybook/addon-a11y": "10.5.3",
        "@storybook/addon-docs": "10.5.3",
        "@storybook/addon-themes": "10.5.3",
        "@storybook/addon-vitest": "10.5.3",
        "@storybook/react-vite": "10.5.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.1.0",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "es-toolkit": "^1.49.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-storybook": "10.5.3",
        "husky": "^9.1.7",
        "i18next-cli": "^1.51.5",
        "laravel-precognition": "^2.0.0",
        "lint-staged": "^17.0.5",
        "msw": "^2.15.0",
        "msw-storybook-addon": "^2.0.7",
        "playwright": "^1.61.1",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "storybook": "10.5.3",
        "tw-animate-css": "^1.4.0",
        "typescript-eslint": "^8.59.4",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@gmcode/forms": "^0.0.8",
        "@gmcode/react-ui": "^0.3.4",
        "@inertiajs/react": "^3.6.1",
        "@inertiajs/vite": "^3.6.1",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/react-table": "^8.21.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "concurrently": "^10.0.3",
        "date-fns": "^4.1.0",
        "i18next": "^26.0.3",
        "i18next-browser-languagedetector": "^8.2.1",
        "laravel-vite-plugin": "^3.1.3",
        "lucide-react": "^1.16.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.71.2",
        "react-i18next": "^17.0.2",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vaul": "^1.1.2",
        "vite": "^8.1.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
        "lightningcss-linux-x64-gnu": "^1.32.0"
    },
    "lint-staged": {
        "!(**/*.php)resources/**/*": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "**/*.php": [
            "php ./vendor/bin/pint"
        ]
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
