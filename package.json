{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "thirteen",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "description": "Laravel 13 application.",
    "author": "Marco Girometta",
    "license": "MIT",
    "packageManager": "pnpm@10.22.0",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --cache --fix",
        "lint:check": "eslint . --cache",
        "preinstall": "npx only-allow pnpm",
        "prepare": "node .husky/install.mjs || true",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "test:ui": "vitest run --project=storybook --coverage",
        "types": "tsc --noEmit"
    },
    "devDependencies": {
        "@inertiajs/core": "^2.3.18",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@storybook/addon-a11y": "^10.3.1",
        "@storybook/addon-docs": "^10.3.1",
        "@storybook/addon-themes": "^10.3.1",
        "@storybook/addon-vitest": "^10.3.1",
        "@storybook/react-vite": "^10.3.1",
        "@types/node": "^22.19.15",
        "@vitest/browser-playwright": "^4.1.0",
        "@vitest/coverage-v8": "^4.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-storybook": "^10.3.1",
        "husky": "^9.1.7",
        "i18next-cli": "^1.50.3",
        "lint-staged": "^16.4.0",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "storybook": "^10.3.1",
        "tw-animate-css": "^1.4.0",
        "typescript-eslint": "^8.57.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@inertiajs/react": "^2.3.18",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-navigation-menu": "^1.2.14",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/react-table": "^8.21.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "concurrently": "^9.2.1",
        "i18next": "^25.9.0",
        "i18next-browser-languagedetector": "^8.2.1",
        "laravel-vite-plugin": "^2.1.0",
        "lucide-react": "^0.561.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.71.2",
        "react-i18next": "^16.5.8",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vaul": "^1.1.2",
        "vite": "^7.3.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
        "lightningcss-linux-x64-gnu": "^1.32.0"
    },
    "lint-staged": {
        "!(**/*.php)resources/**/*": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "**/*.php": [
            "php ./vendor/bin/pint"
        ]
    }
}
