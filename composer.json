{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/blank-react-starter-kit",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.2",
    "laravel/framework": "^13.0",
    "laravel/telescope": "^5.16",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1.14",
    "mobiledetect/mobiledetectlib": "^4.8",
    "sliver/flash-format": "^0.0.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.10",
    "laravel/pint": "^1.27",
    "laravel/sail": "^1.53",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "@composer install --no-interaction --prefer-dist --optimize-autoloader",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --seed --force",
      "vp install",
      "vpr build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "vpx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"vp dev\" --names='server,queue,vite'"
    ],
    "dev:ssr": [
      "vpr build_ssr",
      "Composer\\Config::disableProcessTimeout",
      "vpx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
    ],
    "e2e": [
      "@php artisan config:clear --ansi",
      "Composer\\Config::disableProcessTimeout",
      "@php artisan serve --silent --env=testing"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test --parallel"
    ],
    "format": [
      "pint --parallel"
    ],
    "lint": [
      "phpstan analyse"
    ],
    "check": [
      "@format",
      "@lint"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "scripts-descriptions": {
    "setup": "Install the application",
    "dev": "Start php and vite dev servers",
    "dev:ssr": "Start the php dev server and start the app with SSR enabled",
    "e2e": "Start the php server for e2e tests",
    "test": "Run http tests",
    "format": "Format php code",
    "lint": "Run static analysis",
    "check": "Format php code and run static analysis"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
