{
  "semi": false,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "css",
  "plugins": [
    "prettier-plugin-organize-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindFunctions": ["clsx", "cn"],
  "tabWidth": 2,
  "trailingComma": "none",
  "overrides": [
    {
      "files": "**/*.json",
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
