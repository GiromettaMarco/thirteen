{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "command": "composer run dev",
      "detail": "Start the development server.",
      "label": "$(debug-alt-small) Dev",
      "type": "shell",
      "options": {
        "statusbar": {
          "color": "#22C1D6",
          "detail": "dev",
          "label": "$(debug-alt-small)"
        }
      }
    },
    {
      "command": "composer run dev:ssr",
      "detail": "Start the development server with SSR.",
      "label": "$(play) Dev:SSR",
      "type": "shell",
      "options": {
        "statusbar": {
          "color": "#22C1D6",
          "detail": "dev:ssr",
          "label": "$(play)"
        }
      }
    },
    {
      "command": "Start \"http://localhost:8025/\" && c:/path/to/mailpit/mailpit.exe --database c:/path/to/mailpit/storage/thirteen.db",
      "detail": "Start Mailpit server.",
      "label": "$(mail) Mailpit",
      "options": {
        "statusbar": {
          "color": "#22C1D6",
          "detail": "mailpit",
          "label": "$(mail)"
        }
      },
      "type": "shell"
    },
    {
      "command": "composer run test",
      "detail": "Run PHP unit tests with Pest.",
      "label": "$(beaker) Unit Tests",
      "options": {
        "statusbar": {
          "color": "#22C1D6",
          "detail": "php tests",
          "label": "$(beaker)"
        }
      },
      "type": "shell"
    },
    {
      "command": "vpr e2e:ui",
      "detail": "Run end-to-end tests with Cypress UI.",
      "label": "$(beaker) E2E Tests",
      "options": {
        "statusbar": {
          "color": "#22C1D6",
          "detail": "e2e ui",
          "label": "$(beaker)"
        }
      },
      "type": "shell"
    },
    {
      "command": "php artisan wayfinder:generate",
      "detail": "Generate routes with Wayfinder.",
      "label": "$(type-hierarchy) Wayfinder",
      "options": {
        "statusbar": {
          "color": "#22C1D6",
          "detail": "wayfinder",
          "label": "$(type-hierarchy)"
        }
      },
      "type": "shell"
    }
  ]
}
