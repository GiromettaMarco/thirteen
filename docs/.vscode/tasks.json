{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Laravel $(debug-alt-small)",
            "hide": true,
            "type": "shell",
            "command": "php artisan serve",
            "options": {
                "statusbar": {
                    "detail": "laravel dev server",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "Vite $(debug-alt-small)",
            "hide": true,
            "type": "shell",
            "command": "pnpm run dev",
            "options": {
                "statusbar": {
                    "detail": "dev server",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(debug-alt-small)",
            "dependsOn": [
                "Laravel $(debug-alt-small)",
                "Vite $(debug-alt-small)"
            ],
            "type": "shell",
            "options": {
                "statusbar": {
                    "detail": "dev server",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(play)",
            "type": "shell",
            "command": "pnpm run build:ssr && php artisan inertia:start-ssr",
            "options": {
                "statusbar": {
                    "detail": "prod server",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(mail)",
            "type": "shell",
            "command": "Start \"http://localhost:8025/\" && c:/path/to/mailpit/mailpit.exe --database c:/path/to/mailpit/storage/thirteen.db",
            "options": {
                "statusbar": {
                    "detail": "mailpit",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(test-view-icon)",
            "type": "shell",
            "command": "pnpm run build && php artisan test --exclude-group=browser",
            "options": {
                "statusbar": {
                    "detail": "php tests",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(test-view-icon)",
            "type": "shell",
            "command": "pnpm run build && php artisan test --group=browser --no-coverage",
            "options": {
                "statusbar": {
                    "detail": "e2e tests",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(github-alt)",
            "type": "shell",
            "command": "act -W '.github/workflows/tests.yml' --artifact-server-path /tmp/artifacts",
            "options": {
                "statusbar": {
                    "detail": "act",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(paintcan)",
            "type": "shell",
            "command": "./vendor/bin/pint --dirty",
            "options": {
                "statusbar": {
                    "detail": "pint",
                    "color": "#22C1D6"
                }
            }
        },
        {
            "label": "$(search-fuzzy)",
            "type": "shell",
            "command": "./vendor/bin/phpstan analyse",
            "options": {
                "statusbar": {
                    "detail": "phpstan",
                    "color": "#22C1D6"
                }
            }
        }
    ]
}
