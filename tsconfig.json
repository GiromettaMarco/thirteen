{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ESNext",

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    /* JavaScript Support */
    "allowJs": true,

    /* Emit */
    "noEmit": true,

    /* Interop Constraints */
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,

    /* Completeness */
    "types": ["cypress", "cypress-real-events", "node"],
    "skipLibCheck": false,
    "paths": {
      "@/*": ["./resources/js/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["cypress.config.ts", "cypress", "resources/js"]
}
